{
  "name": "unfurl-ui",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "description": "Coordinated frontend workspace for the Unfurl host shell, Fabric Studio, shared UI contracts, and themes.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --force",
    "test": "npm run typecheck && node scripts/run-tests.mjs",
    "clean": "node scripts/clean.mjs",
    "dev:studio": "npm run dev -w @unfurl/host-shell",
    "dev:studio:fixture": "npm run dev:fixture -w @unfurl/host-shell",
    "build:studio": "npm run build -w @unfurl/host-shell",
    "launch:studio": "powershell -ExecutionPolicy Bypass -File scripts/launch-studio.ps1",
    "test:browser:host": "node scripts/verify-host-runtime.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react-test-renderer": "^18.3.0",
    "@types/three": "^0.184.1",
    "playwright": "^1.60.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
