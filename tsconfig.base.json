{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@unfurl/ui-contracts": ["packages/ui-contracts/src/index.ts"],
      "@unfurl/component-manifest": ["packages/component-manifest/src/index.ts"],
      "@unfurl/visual-manifest": ["packages/visual-manifest/src/index.ts"],
      "@unfurl/fabric-scene-model": ["packages/fabric-scene-model/src/index.ts"],
      "@unfurl/fabric-validation-client": ["packages/fabric-validation-client/src/index.ts"],
      "@unfurl/theme-engine": ["packages/theme-engine/src/index.ts"],
      "@unfurl/three-renderer": ["packages/three-renderer/src/index.ts"],
      "@unfurl/graph-layout": ["packages/graph-layout/src/index.ts"],
      "@unfurl/design-system": ["packages/design-system/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}
